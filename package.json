{
  "name": "ios-ota-device-collector",
  "version": "1.0.0",
  "description": "Over-The-Air iOS configuration profile for collecting device information (UDID, IMEI, Serial Number, etc.)",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "docker:build": "docker build -t ios-ota-collector .",
    "docker:run": "docker-compose up -d"
  },
  "keywords": [
    "ios",
    "udid",
    "device-info",
    "mobileconfig",
    "ota",
    "configuration-profile"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "helmet": "^7.1.0",
    "express-rate-limit": "^7.1.5",
    "plist": "^3.1.0",
    "node-forge": "^1.3.1",
    "qrcode": "^1.5.3",
    "js-yaml": "^4.1.0",
    "dotenv": "^16.3.1",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "nodemon": "^3.0.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
